# Copiez ce fichier en .env et renseignez vos valeurs. NE PAS versionner .env.

# ── Sécurité ──────────────────────────────────────────────
FLASK_SECRET=change-me-generate-a-long-random-value
API_TOKEN=change-me-token-for-manual-trade-endpoint
CORS_ORIGINS=http://localhost:8080

# ── Exchange ──────────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=
TESTNET_SPOT=true
TESTNET_FUTURES=true

# ── Data feed ─────────────────────────────────────────────
# sim = paper-trading (aucun réseau) | binance = prix réels (API publique)
DATA_FEED=sim
POLL_INTERVAL=5

# ── Trading ───────────────────────────────────────────────
CAPITAL=1000
RISK_PCT=0.02
MAX_DRAWDOWN=0.10
MAX_PER_PAIR_RISK=0.05
HEDGE_MODE=auto
SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT

# ── Alertes (optionnel) ───────────────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK=
EMAIL_SMTP=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
